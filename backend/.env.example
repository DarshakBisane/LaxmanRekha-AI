APP_ENV=development
APP_NAME="LaxmanRekha AI"
SECRET_KEY=change_this_to_a_random_secure_hex_key
JWT_SECRET_KEY=change_this_to_a_random_jwt_secret_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

DATABASE_URL=postgresql+psycopg://user:password@host/neondb?sslmode=require
DIRECT_DATABASE_URL=postgresql+psycopg://user:password@host/neondb?sslmode=require

UPSTASH_REDIS_REST_URL=https://your-upstash-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token

GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-1.5-flash

FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

COOKIE_SECURE=false
COOKIE_SAMESITE=lax

MAX_UPLOAD_MB=10
DEMO_MODE=true
